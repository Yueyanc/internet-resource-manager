# The server reads environment variables, not this file automatically.
IRM_LISTEN_ADDR=127.0.0.1:8787
IRM_DATA_DIR=data
# Optional: comma-separated public origins allowed by Host & CrossOriginProtection behind reverse proxy
# IRM_ALLOWED_ORIGINS=https://irm.example.com
# Optional: trust X-Forwarded-Proto and X-Real-IP from local/private reverse proxy peers
# IRM_TRUST_PROXY=true
# Optional: idempotent initial administrator bootstrap on first boot (must be set together)
# IRM_ADMIN_USER=admin
# IRM_ADMIN_PASSWORD=change-me-at-least-8-chars
# Optional: dedicated outbound-agent listener on Tailscale/LAN IP (mounts ONLY /agent/v1, never /api/v1 or Web UI)
# IRM_AGENT_LISTEN_ADDR=100.64.0.1:8788
# Optional: directory containing cross-built irm-agent-linux-{amd64,arm64} binaries (defaults to dist/)
# IRM_AGENT_BIN_DIR=dist
